{
  "name": "@zaydiscold/goodreads-cli",
  "version": "1.1.0",
  "private": true,
  "description": "Unofficial Goodreads CLI for books, shelves, reading data, and safely gated account automation. Optional MCP support.",
  "keywords": [
    "goodreads",
    "cli",
    "books",
    "reading",
    "kindle",
    "automation",
    "mcp"
  ],
  "type": "module",
  "bin": {
    "goodreads-cli": "dist/index.js"
  },
  "exports": {
    ".": "./dist/api.js",
    "./engine": "./dist/publicEngine.js",
    "./internal-engine": "./dist/engine.js",
    "./lib": "./dist/lib.js",
    "./live": "./dist/client/live.js",
    "./risk": "./dist/risk.js",
    "./workflows": "./dist/workflows/recentReading.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-api-map.mjs",
    "cli": "tsx src/index.ts",
    "api-map:endpoints": "node scripts/generate-endpoint-markdown.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "commander": "^14.0.3",
    "domhandler": "^5.0.3",
    "fast-xml-parser": "^5.10.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "tsx": "^4.23.1"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zaydiscold/goodreads-cli-mcp-api.git"
  },
  "bugs": {
    "url": "https://github.com/zaydiscold/goodreads-cli-mcp-api/issues"
  },
  "homepage": "https://github.com/zaydiscold/goodreads-cli-mcp-api#readme",
  "author": "Zayd Khan (@ColdCooks / zaydiscold)",
  "license": "MIT"
}
